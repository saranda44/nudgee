# Copia este archivo a .env.development.local (para `npm run dev`) y a .env.production.local
# (para `npm run build`) — llena los valores con `terraform output` en infra/. No son secretos,
# pero cambian por integrante.
#
# VITE_COGNITO_DOMAIN y VITE_COGNITO_CLIENT_ID van en los dos archivos, iguales.
# API_PROXY_TARGET solo en .env.development.local (lo usa el proxy de Vite en dev).
# VITE_API_BASE_URL solo en .env.production.local (sin esto el build de producción no sabría a
# dónde pegarle: sin CloudFront ya no comparte origen con la API — ver infra/main.tf).

# URL de la API Gateway; el proxy de Vite manda /v1 ahí (solo en local, con `npm run dev`).
API_PROXY_TARGET=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# La misma URL, pero para el build de producción: el cliente le pega cross-origin con esto de
# prefijo.
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# Dominio del Hosted UI de Cognito (sin barra final).
VITE_COGNITO_DOMAIN=https://nudgee-auth-dev-<nombre>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
